# The backend is intentionally restricted to loopback.
JARVIS_AGENT_HOST=127.0.0.1
JARVIS_AGENT_PORT=8765
JARVIS_LOG_LEVEL=INFO

# Gemini credentials are read only by the Python agent. Leave blank until configured.
GEMINI_API_KEY=

# Optional local interpreter override. Never place secrets here.
# JARVIS_PYTHON_PATH=C:\\path\\to\\python.exe
