# The backend is intentionally restricted to loopback.
JARVIS_AGENT_HOST=127.0.0.1
JARVIS_AGENT_PORT=8765
JARVIS_LOG_LEVEL=INFO

# Gemini credentials are read only by the Python agent. Leave blank until configured.
GEMINI_API_KEY=
JARVIS_SEARCH_URL_TEMPLATE=https://www.google.com/search?q={query}

# Optional semicolon-separated trusted roots and resolver tuning.
JARVIS_FOLDER_ROOTS=
JARVIS_FOLDER_INDEX_MAX_DEPTH=3
JARVIS_RESOLVER_REFRESH_SECONDS=300
JARVIS_USER_ALIASES_PATH=config/user-aliases.json

# Optional local interpreter override. Never place secrets here.
# JARVIS_PYTHON_PATH=C:\\path\\to\\python.exe
